[Unit]
Description=airlock warm-connection daemon for TypeSafe

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m airlock.daemon
WorkingDirectory=%h/.local/share/airlock/current
Restart=on-failure
RestartSec=5
Nice=5
MemoryMax=150M
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=airlock
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
